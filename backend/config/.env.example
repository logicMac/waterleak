# ── LeakGuard backend configuration ──────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

APP_ENV=local
# Origin allowed to call the admin API (the Vite dev server, or your domain).
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leakguard
DB_USER=root
DB_PASS=

# Shared secret the ESP32 sends as the X-API-Key header. Must match the
# firmware's API_KEY. Generate a long random value.
DEVICE_API_KEY=change-me-to-a-long-random-string

SESSION_NAME=LGSESS
# Device is "offline" when no /report has arrived for this many seconds.
OFFLINE_AFTER_S=15
# Pending commands older than this are expired so a stale command never runs.
COMMAND_TTL_S=30
# readings rows older than this are removed by cron/cleanup.php
READING_RETENTION_DAYS=30

# ── Email notifications (SMTP) ───────────────────────────────────
# Leave SMTP_HOST empty to disable email silently.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=leakguard@localhost
SMTP_FROM_NAME=LeakGuard

# ── SMS (planned — SIM900A on-device, or provider API e.g. Semaphore) ──
# none | semaphore | sim900a
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER=LeakGuard
